    "highcharts": "^13.1.1",
    "highcharts-react-official": "^3.2.3",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chromatic": "^18.11.0",
    "happy-dom": "^20.14.5",
    "oxc-transform-react": "^0.152.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
