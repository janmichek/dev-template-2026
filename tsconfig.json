{
  // Editor entry. Compiler options live in config/tsconfig.base.json.
  // Not named tsconfig.json inside config/: Vite would load that file from the config
  // directory and miss these path mappings. TypeScript 7 resolves paths from this file.
  "extends": "./config/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@server/*": ["./server/*"],
      "@shared/*": ["./shared/*"],
      "@test/*": ["./test/*"]
    }
  }
}
