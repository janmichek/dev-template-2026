{
  "name": "dev-template-2026",
  "version": "0.1.0",
  "private": true,
  "author": "Jan Michek",
  "type": "module",
  "scripts": {
    "start": "vite --config config/vite.config.ts",
    "dev": "docker compose up --build",
    "build": "vite build --config config/vite.config.ts",
    "vercel:build": "bun run build && bun scripts/build-vercel.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit": "bun audit --production",
    "lint": "oxlint -c config/oxlintrc.json --ignore-pattern .agents --ignore-pattern .claude --ignore-pattern .cursor --ignore-pattern agent --ignore-pattern examples --ignore-pattern scripts/diagram/page.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fsd": "steiger src --fail-on-warnings",
    "dead-code": "fallow dead-code -c config/.fallowrc.json",
    "duplicates": "fallow dupes -c config/.fallowrc.json --fail-on-issues",
    "api:generate": "bun scripts/link-typescript5.ts && bun scripts/generate-openapi.ts",
    "diagram:page": "bun scripts/diagram-page.ts",
    "api:check": "bun run api:generate && git diff --exit-code -- shared/openapi.json src/shared/api/schema.d.ts",
    "test:all": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run --config config/vite.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:mutate": "bun scripts/link-typescript5.ts && stryker run config/stryker.config.json",
    "storybook": "storybook dev -p 6006 -c config/storybook",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "hono": "^4.13.13",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "^10.6.2",
    "@stryker-mutator/core": "^10.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chromatic": "^18.13.0",
    "esbuild": "0.28.2",
    "fallow": "^3.37.0",
    "happy-dom": "^21.0.3",
    "openapi-typescript": "^7.13.0",
    "oxc-transform-react": "^0.154.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "steiger": "^0.7.0",
    "storybook": "^10.6.2",
    "typescript": "7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
