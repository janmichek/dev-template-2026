  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "docker compose up --build",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c .oxlintrc.json",
    "fmt": "oxfmt -c .oxfmtrc.json",
