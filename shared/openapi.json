{
  "openapi": "3.1.0",
  "info": {
    "title": "Dev template 2026",
    "version": "0.1.0"
  },
  "paths": {
    "/api/cars": {
      "get": {
        "operationId": "listCars",
        "responses": {
          "200": {
            "description": "Cars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "number"
                      },
                      "make": {
                        "type": "string"
                      },
                      "model": {
                        "type": "string"
                      },
                      "year": {
                        "type": "number"
                      },
                      "mileageKm": {
                        "type": "number"
                      },
                      "priceUsd": {
                        "type": "number"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "available",
                          "reserved",
                          "sold"
                        ]
                      },
                      "listedAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      }
                    },
                    "required": [
                      "id",
                      "make",
                      "model",
                      "year",
                      "mileageKm",
                      "priceUsd",
                      "status",
                      "listedAt"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/makes": {
      "get": {
        "operationId": "listMakes",
        "responses": {
          "200": {
            "description": "Makes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "symbol": {
                        "type": "string"
                      },
                      "color": {
                        "type": "string",
                        "enum": [
                          "gray",
                          "orange",
                          "iris",
                          "blue",
                          "teal"
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "name",
                      "symbol",
                      "color"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/cars/{id}/reserve": {
      "post": {
        "operationId": "reserveCar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reserved car",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "make": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "year": {
                      "type": "number"
                    },
                    "mileageKm": {
                      "type": "number"
                    },
                    "priceUsd": {
                      "type": "number"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "available",
                        "reserved",
                        "sold"
                      ]
                    },
                    "listedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "id",
                    "make",
                    "model",
                    "year",
                    "mileageKm",
                    "priceUsd",
                    "status",
                    "listedAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "No such car"
          },
          "409": {
            "description": "Car is not available"
          }
        }
      }
    }
  }
}
