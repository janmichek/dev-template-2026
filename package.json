{
  "name": "dev-template-2026",
  "version": "0.1.0",
  "private": true,
  "author": "Jan Michek",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "vite --config config/vite.config.ts",
    "dev": "docker compose up --build",
    "build": "vite build --config config/vite.config.ts",
    "vercel:build": "bun run build && bun scripts/build-vercel.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:static": "bun run typecheck && bun run lint && bun run fmt:check && bun run fsd && bun run dead-code && bun run duplicates && bun run agent:context",
    "validate": "bun run check:static && bun run api:check && bun run build && bun run test:coverage",
    "audit": "bun audit --production",
    "lint": "oxlint -c config/oxlintrc.json --ignore-pattern .agents --ignore-pattern .claude --ignore-pattern .cursor --ignore-pattern agent --ignore-pattern examples --ignore-pattern scripts/diagram/page.js --ignore-pattern tools/oxlint/anti-slop --ignore-pattern src/shared/api/schema.d.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fsd": "steiger src --fail-on-warnings",
    "dead-code": "fallow dead-code -c config/.fallowrc.json",
    "duplicates": "fallow dupes -c config/.fallowrc.json --fail-on-issues",
    "agent:context": "bun scripts/agent-context-check.ts",
    "api:generate": "bun scripts/link-typescript5.ts && bun scripts/generate-openapi.ts",
    "diagram:page": "bun scripts/diagram-page.ts",
    "api:check": "bun run api:generate && git diff --exit-code -- shared/openapi.json src/shared/api/schema.d.ts",
    "test:all": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run --config config/vite.config.ts",
    "test:coverage": "vitest run --config config/vite.config.ts --coverage",
    "coverage:ratchet": "bun run test:coverage && bun scripts/ratchet-coverage.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:mutate": "bun scripts/link-typescript5.ts && stryker run config/stryker.config.json",
    "storybook": "storybook dev -p 6006 -c config/storybook",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@sentry/react": "^11.17.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "hono": "^4.13.22",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@oxlint/plugins": "1.95.0",
    "@playwright/mcp": "^0.0.86",
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "^10.6.9",
    "@stryker-mutator/core": "^10.1.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "chromatic": "^18.15.3",
    "esbuild": "0.28.2",
    "fallow": "^3.48.0",
    "fast-check": "^4.11.0",
    "happy-dom": "^21.0.3",
    "openapi-typescript": "^7.13.0",
    "oxc-transform-react": "^0.158.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "steiger": "^0.10.0",
    "storybook": "^10.6.9",
    "tsrs": "^7.1.0-beta.tsrs3",
    "typescript": "7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
