{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(bun add:*)",
      "Bash(bun remove:*)",
      "Bash(bun update:*)",
      "Bash(bun install:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(yarn add:*)",
      "Bash(yarn install:*)",
      "Bash(npx:*)",
      "Bash(bunx:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(gh pr merge:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat **/.env*)",
      "Bash(head .env*)",
      "Bash(head ./.env*)",
      "Bash(tail .env*)",
      "Bash(tail ./.env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(grep * .env*)",
      "Bash(grep * ./.env*)",
      "Bash(sed * .env*)",
      "Bash(awk * .env*)",
      "Bash(cp .env*)",
      "Bash(printenv*)"
    ]
  }
}
